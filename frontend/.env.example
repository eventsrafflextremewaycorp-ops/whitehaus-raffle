# Development: leave empty. The browser calls /api on the Vite server, which proxies to Laravel.
# VITE_DEV_API=http://localhost:8000   # where `php artisan serve` listens
#
# Only if the API is on a DIFFERENT (sub)domain in production, e.g. https://api.example.com/api
# (the frontend and API must then share a parent domain for cookie sign-in to work).
# VITE_API_BASE_URL=
