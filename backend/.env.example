APP_NAME=WhiteHaus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite works out of the box (database/database.sqlite).
# For MySQL: DB_CONNECTION=mysql and fill in DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD.
DB_CONNECTION=sqlite

# --- React frontend + Sanctum SPA authentication --------------------------
# Development: the React dev server (http://localhost:5173) proxies /api and /sanctum to this app,
# so everything is same-origin. List every host[:port] the browser uses to open the site.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:8000
# Only needed if the React app is served from a DIFFERENT origin than Laravel (comma-separated).
FRONTEND_URLS=http://localhost:5173
# Leave empty for a single domain. Use ".example.com" only if the site is on www.example.com and the API on api.example.com.
SESSION_DOMAIN=null

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Registration e-mail ---------------------------------------------------
# "log" writes the e-mail to storage/logs/laravel.log (nothing is sent) - fine for development.
# For real delivery set MAIL_MAILER=smtp and fill in the SMTP details from your mail host.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin@xtremewaycorp.com
MAIL_FROM_NAME="WhiteHaus"

# --- First admin account (used once by `php artisan db:seed`) --------------
# Leave blank and run `php artisan gx:create-admin` instead if you prefer a prompt.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Campaign (defaults in config/promo.php match the live site) ----------
# PROMO_PERIOD_START=2026-10-23
# PROMO_PERIOD_END=2026-12-31
# PROMO_DRAW_AT="2027-01-04 15:00"
# PROMO_REGISTRATION_OPEN=true
# PROMO_MAX_DRAW=23        (Weeks 2 to 10 have 11 winners: set 11 once the Week 1 draw is finished)
# PROMO_MAJOR_DRAWS=3
